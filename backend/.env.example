# Copy this file to .env and fill in your own values. Never commit .env.

# Firebase Admin SDK key file lives at backend/serviceAccountKey.json (gitignored).
# Download it from Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key". Override the path here if you move it.
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Serial port the ESP32 is on. Windows: COM3, COM4... (check Device Manager).
# Linux: /dev/ttyUSB0   macOS: /dev/tty.usbserial-0001
# Run `npm run ports` to list available ports.
SERIAL_PORT=COM3

# Must match Serial.begin() in the firmware
BAUD_RATE=115200

# The single-reader sketch prints "UID: B0 E3 90 5C" with no reader id, so the
# backend has to decide which reader it came from. CHECKPOINT = borrow/return.
# Set this to a shelf id (e.g. SHELF2_A) to test the misplaced-book logic with
# only one reader wired up.
DEFAULT_READER_ID=CHECKPOINT

# Port the REST API listens on
PORT=4000
