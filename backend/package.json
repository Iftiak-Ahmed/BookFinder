{
  "name": "bookfinder-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js backend for BookFinder — reads RFID scans from the ESP32 over USB serial and writes them to Firebase Firestore.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "ports": "node -e \"import('serialport').then(m=>m.SerialPort.list()).then(l=>console.log(l.map(p=>`${p.path}  ${p.manufacturer||''}`).join('\\n')||'no serial ports found'))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.2.0",
    "serialport": "^12.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
